# Auto-detect text files and normalize to LF in repo
* text=auto eol=lf

# Solution and project files should use CRLF on Windows
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Source code: normalize to LF in repo, but editors handle correctly
*.cs      text diff=csharp
*.vb      text
*.fs      text

# Config and data
*.json    text
*.yml     text
*.yaml    text
*.xml     text
*.config  text
*.md      text
*.txt     text

# Scripts
*.sh      text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary files - never diff or change line endings
*.dll     binary
*.exe     binary
*.pdb     binary
*.jpg     binary
*.jpeg    binary
*.png     binary
*.gif     binary
*.ico     binary
*.zip     binary
*.tar     binary
*.gz      binary
*.7z      binary
*.pdf     binary
