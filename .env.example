# Redpanda (Kafka-compatible) broker for local dev
# Example: 100.97.224.69:9092 (Tailscale IP)
REDPANDA_BOOTSTRAP_SERVERS=100.97.224.69:9092

# Internal token Ingestion uses when calling Storage.Api
# Must match InternalAuth:ApiKey used by tu-storage-service
INTERNAL_AUTH_API_KEY=changeme

# Base URL for Storage.Api as seen from inside the ingestion container
# Storage dev compose exposes it on localhost:8080 on the host.
STORAGE_BASE_URL=http://host.docker.internal:8080
